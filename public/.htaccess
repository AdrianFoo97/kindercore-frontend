# The installable-app manifest must be served as JSON.
AddType application/manifest+json .webmanifest
Options -MultiViews
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.html [QSA,L]

# After a deploy, browsers must pick up the new app straight away: the page
# itself (index.html, which every route falls back to) is always re-checked.
# The build's /assets/ files get a new name on every change, so they need nothing.
<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
